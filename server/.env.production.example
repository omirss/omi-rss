# Node Environment
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://omi_user:your_secure_password@postgres:5432/omi_rss
POSTGRES_DB=omi_rss
POSTGRES_USER=omi_user
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT & Security
JWT_SECRET=your-very-long-random-string-here
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# CORS
CORS_ORIGIN=https://your-domain.com,https://app.your-domain.com

# Domain
DOMAIN_NAME=your-domain.com

# Email Service (optional - enables password reset / email verify)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Monitoring
GRAFANA_PASSWORD=your-grafana-password
PROMETHEUS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7
LOG_COMPRESS=true

# Performance
ENABLE_QUERY_LOGGING=false
ENABLE_REQUEST_LOGGING=true
CACHE_TTL=3600

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=30
