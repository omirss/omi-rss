# Node Environment
NODE_ENV=production
PORT=3000

# Frontend URL (used in verification / password reset email links)
FRONTEND_URL=https://app.your-domain.com

# Database
DATABASE_URL=postgresql://omi_user:your_secure_password@postgres:5432/omi_rss
POSTGRES_DB=omi_rss
POSTGRES_USER=omi_user
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6379

# JWT & Security
JWT_SECRET=your-very-long-random-string-here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://your-domain.com,https://app.your-domain.com

# Email Service (optional - enables password reset / email verify)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Content retention (days, cleanup worker)
ARTICLE_RETENTION_DAYS=90

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs
