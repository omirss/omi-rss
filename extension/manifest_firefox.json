{
  "manifest_version": 3,
  "name": "Omi RSS Reader",
  "version": "0.5.0",
  "description": "Save articles and read your feeds from anywhere",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "contextMenus",
    "notifications",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "js/config.js",
      "js/api.js",
      "js/sync-manager.js",
      "js/file-sync.js",
      "js/storage-service.js",
      "js/feed-parser.js",
      "js/feed-scheduler.js",
      "js/background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/sanitize.js",
        "js/content.js",
        "js/extractors/site-specific.js"
      ],
      "css": ["css/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-article": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current article"
    },
    "toggle-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Toggle reader mode"
    },
    "open-sidepanel": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open RSS Reader Panel"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{41a6adaa-f9f6-429c-b579-48e0f0697dfe}",
      "strict_min_version": "109.0"
    }
  }
}