# Database (omirss-pg container)
DATABASE_URL=postgres://omi_rss:omi_rss@localhost:5433/omi_rss

# Queue/cache (omirss-redis container)
REDIS_URL=redis://localhost:6380

# Auth (port of server/ JWT bearer contract)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=3000

# Public frontend origin used in verification/reset email links
FRONTEND_URL=http://localhost:3000

# Trust forwarding headers for rate limiting: false (direct exposure), true (one trusted proxy), or a CIDR list like 10.0.0.0/8,192.168.1.5
TRUSTED_PROXY=false

# Dev convenience only: allow feed URLs pointing at loopback/private/link-local addresses (SSRF guard bypass)
ALLOW_PRIVATE_FEED_URLS=false

# Access token expiry window (jwt.sign expiresIn format)
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=10

# Max upload size in bytes (avatars, OPML import)
MAX_FILE_SIZE=5242880

# Directory where avatars/uploads are stored and served from /uploads
UPLOAD_DIR=./uploads

# Days before articles are deleted by the cleanup job
ARTICLE_RETENTION_DAYS=90

# Runtime mode: development | production (production enables strict auth/rate-limit behavior)
NODE_ENV=development
